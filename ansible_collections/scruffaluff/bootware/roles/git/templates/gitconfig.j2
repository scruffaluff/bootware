# Git configuration file.
#
# For more information, visit https://git-scm.com/docs/git-config.

[advice]
detachedHead = false

[alias]
alias = config --get-regexp ^alias
amend = commit --amend
cancel = reset --soft HEAD^
edit = !$EDITOR $(git status --porcelain | awk '{print $2}')
head = diff HEAD
list = log --oneline
search = !git rev-list --all | xargs git grep --fixed-strings
squash = "!f() { git reset --soft HEAD~$1 && git commit; }; f"
state = status --branch --short

[core]
autocrlf = input
editor = hx
{% if ansible_facts.system != "Linux" or system_architecture == "amd6" or system_libc == "gnu" %}
pager = delta
{% endif %}

[delta]
line-numbers = true
navigate = true
syntax-theme = Solarized (light)

[diff]
colorMoved = default

[init]
defaultBranch = main

{% if ansible_facts.system != "Linux" or system_architecture == "amd64" or system_libc == "gnu" %}
[interactive]
diffFilter = delta --color-only
{% endif %}

[merge]
conflictstyle = diff3

[pull]
rebase = false

[user]
email = {{ git_user_email }}
name = {{ git_user_name }}
